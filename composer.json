{
  "name": "gordonmurray/tesco-api",
  "description": "Unofficial Tesco Ireland API wrapper, price tracker and shopping-list estimator",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.5.12",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": { "phpunit/phpunit": "^13.4" },
  "autoload": { "psr-4": { "Tesco\\": "src/" } },
  "autoload-dev": { "psr-4": { "Tesco\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit", "check": ["@test", "@composer validate --strict", "@composer audit"] },
  "config": { "sort-packages": true, "allow-plugins": {}, "platform": { "php": "8.5.12" } }
}
